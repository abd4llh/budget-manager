# Budget Manager 0.9.0-beta
# Copy to .env and replace every CHANGE_ME value.
# Optional: pin the Docker Compose project/volume namespace.
# COMPOSE_PROJECT_NAME=budget-manager

DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_DATABASE_PASSWORD

BUDGET_ADMIN_USERNAME=admin
BUDGET_ADMIN_PASSWORD=CHANGE_ME_CHOOSE_A_STRONG_LOGIN_PASSWORD
BUDGET_ADMIN_EMAIL=
BUDGET_ADMIN_RESET_PASSWORD=0

POSTGRES_DB=budget
POSTGRES_USER=budget
POSTGRES_HOST=db
POSTGRES_PORT=5432
TZ=UTC
BUDGET_PORT=8015
BACKUP_RETENTION_DAYS=30
SERVER_IMAGE_TAG=local

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 only when requests pass through a trusted reverse proxy that sets X-Forwarded-Proto/Host.
DJANGO_TRUST_PROXY_HEADERS=0
DJANGO_COOKIE_SECURE=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# Optional Android LAN discovery.
BUDGET_MANAGER_DISCOVERY_PORT=7358
BUDGET_MANAGER_DISCOVERY_NAME=Budget Manager
BUDGET_MANAGER_DISCOVERY_URL=

# Optional read-only bank sync via Enable Banking.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_B64=
BANK_SYNC_BASE_URL=
BANK_SYNC_LOOKBACK_DAYS=90
BANK_SYNC_DISABLE=0

# Published container image used by compose.release.yaml.
# Prefer an immutable digest after verifying the image you want.
# BUDGET_SERVER_IMAGE=ghcr.io/abd4llh/budget-manager-server:0.9.0-beta
